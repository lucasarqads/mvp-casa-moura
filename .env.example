# Copie este arquivo para .env e ajuste os valores.
# Em produção, gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=sua_chave_secreta_demo

# SQLite (desenvolvimento). Para PostgreSQL, instale "psycopg[binary]" e use:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/casamoura
DATABASE_URL=sqlite:///./casamoura_demo.db

# Validade do token de acesso, em horas.
TOKEN_EXPIRA_HORAS=8
